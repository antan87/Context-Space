{
  "name": "contextspace-vscode",
  "displayName": "ContextSpace Multi-Repo Workspace Orchestrator",
  "description": "Manage multiple repositories as a single feature workspace, orchestrate background services, and align AI coding contexts natively inside VS Code.",
  "version": "2.39.0",
  "publisher": "contextspace",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/antan87/NexusFlow.git"
  },
  "files": [
    "dist/**/*.js",
    "media/**",
    "LICENSE"
  ],
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:contextspace.json",
    "workspaceContains:nexusflow.json",
    "workspaceContains:workspace.json"
  ],
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "contextspace-mcp",
        "label": "ContextSpace MCP Server"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "contextspace-sidebar",
          "title": "ContextSpace",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "contextspace-sidebar": [
        {
          "type": "webview",
          "id": "contextspace.dashboardView",
          "name": "ContextSpace Dashboard"
        }
      ]
    },
    "commands": [
      {
        "command": "nexusflow.openDashboard",
        "title": "Open Sidebar Dashboard",
        "category": "ContextSpace"
      },
      {
        "command": "nexusflow.openBrowserDashboard",
        "title": "Open Web Dashboard (Browser)",
        "category": "ContextSpace"
      },
      {
        "command": "nexusflow.openTui",
        "title": "Open Terminal GUI (TUI)",
        "category": "ContextSpace"
      },
      {
        "command": "nexusflow.createWorkspace",
        "title": "Create Workspace",
        "category": "ContextSpace"
      },
      {
        "command": "nexusflow.syncWorkspace",
        "title": "Sync Workspace",
        "category": "ContextSpace"
      },
      {
        "command": "nexusflow.runDoctor",
        "title": "Run Doctor Diagnostics",
        "category": "ContextSpace"
      },
      {
        "command": "nexusflow.commitWorkspace",
        "title": "Commit Workspace Changes",
        "category": "ContextSpace"
      }
    ],
    "keybindings": [
      {
        "command": "nexusflow.openTui",
        "key": "ctrl+alt+t",
        "mac": "cmd+alt+t",
        "when": "editorTextFocus && nexusflow.workspaceActive"
      },
      {
        "command": "nexusflow.syncWorkspace",
        "key": "ctrl+alt+s",
        "mac": "cmd+alt+s",
        "when": "editorTextFocus && nexusflow.workspaceActive"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile && node scripts/prepare-package.mjs",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.4.0",
    "@types/vscode": "1.125.0",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.62.1",
    "@vscode/codicons": "^0.0.45",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "eslint": "^10.9.1",
    "glob": "^13.0.6",
    "mocha": "^12.0.0",
    "typescript": "~6.0.3"
  }
}
