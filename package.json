{
  "name": "@mrpatronz/nexusflow",
  "version": "2.39.0",
  "description": "Combine multiple repos into a workspace with rich AI assistant context",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antan87/NexusFlow.git"
  },
  "main": "dist/index.js",
  "bin": {
    "ctxspace": "dist/index.js",
    "contextspace": "dist/index.js",
    "cs": "dist/index.js",
    "nexusflow": "dist/index.js"
  },
  "files": [
    "dist",
    "resources",
    "desktop/assets/icon.png"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc && node scripts/copy-resources.mjs && npm run build --prefix gui",
    "build:backend": "tsc && node scripts/copy-resources.mjs",
    "setup": "npm install --prefix gui && npm install --prefix desktop && npm run setup --prefix desktop && npm install --prefix extension",
    "version": "node scripts/sync-version.mjs && git add -A",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "ui": "node dist/index.js ui",
    "test": "vitest run",
    "release:preflight": "node scripts/release-preflight.mjs",
    "release:ship": "node scripts/release-ship.mjs",
    "test:watch": "vitest",
    "test:gui": "npm run test:e2e --prefix gui",
    "check:skills": "node scripts/check-development-skills.mjs",
    "perf": "node perf/timing.mjs",
    "perf:fixture": "node perf/fixture/generate.mjs",
    "perf:rules": "node perf/rules.mjs",
    "smoke:chat": "npx tsx scripts/smoke-chat-engines.ts",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run build",
    "extension:install": "npm install --prefix extension",
    "extension:compile": "npm run compile --prefix extension"
  },
  "keywords": [
    "ai",
    "workspace",
    "multi-repo",
    "claude",
    "codex",
    "copilot",
    "cursor",
    "developer-tools"
  ],
  "author": "Anton Patron",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.5.1",
    "@anthropic-ai/claude-agent-sdk": "0.3.284",
    "@anthropic-ai/sdk": "^0.129.0",
    "@google/genai": "^2.10.0",
    "@hono/node-server": "^2.0.8",
    "@hono/node-ws": "^1.3.1",
    "@inquirer/prompts": "^8.5.2",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@openai/codex-sdk": "0.159.0",
    "@vscode/tree-sitter-wasm": "^0.3.1",
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "execa": "^10.0.1",
    "fs-extra": "^11.3.6",
    "globby": "^16.2.0",
    "hono": "^4.12.27",
    "js-yaml": "^5.2.3",
    "openai": "^7.9.0",
    "ora": "^9.4.1",
    "pm2": "^7.0.3",
    "selfsigned": "5.5.0",
    "smol-toml": "^1.8.0",
    "web-tree-sitter": "^0.27.0",
    "zod": "^4.4.3"
  },
  "overrides": {
    "@hono/node-server": "$@hono/node-server",
    "@hono/node-ws": {
      "@hono/node-server": "$@hono/node-server"
    },
    "basic-ftp": "6.2.1",
    "pm2": {
      "js-yaml": "4.3.2"
    }
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.1.0",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "optionalDependencies": {
    "node-pty": "1.1.0"
  }
}
